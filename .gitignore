# ==========================================
# CampusPulse .gitignore
# ==========================================

# 1. Environment & Confidential Credentials
.env
.env.*
*.env
backend/.env
backend/.env.*
skills-lock.json
.agents/
.system_generated/
.user_uploaded/
scratch/
backend/supabase/.temp/
supabase/.temp/
.temp/

# 2. Markdown Files & Documentation (Explicit User Directive)
*.md
docs/
prompts/

# 3. Dependencies & Build Outputs
node_modules/
backend/node_modules/
dist/
build/
.cache/

# 4. Logs & Runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. OS & Editor configs
.DS_Store
Thumbs.db
.vscode/
.idea/
