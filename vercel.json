{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/events",
      "destination": "/frontend/events.html"
    },
    {
      "source": "/event",
      "destination": "/frontend/event.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/signup.html"
    },
    {
      "source": "/dashboard",
      "destination": "/frontend/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/admin-events",
      "destination": "/frontend/admin-events.html"
    },
    {
      "source": "/admin-participants",
      "destination": "/frontend/admin-participants.html"
    },
    {
      "source": "/my-registrations",
      "destination": "/frontend/my-registrations.html"
    },
    {
      "source": "/dsa-lab",
      "destination": "/frontend/dsa-lab.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
